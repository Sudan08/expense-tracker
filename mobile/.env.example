# Copy to .env and fill in from the Supabase project the wizard created
# (scripts/setup-wizard.sh, run from the repo root). The anon key is safe to
# ship in the app -- RLS is what actually protects the data (plan section 11.1).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Sender IDs of banks whose SMS to collect, comma-separated and matched
# case-insensitively as a substring (e.g. SMS_SENDERS=NabilBank,LaxmiSunrise).
# Worth listing a bank even when it also emails: Nabil sends both, the SMS
# arrives in seconds rather than at the next worker sync, and the two legs
# collapse onto one transaction rather than double-counting.
# Default deny: leave this empty and the app uploads no SMS at all. Your
# inbox also holds OTPs and personal messages -- only list bank senders.
SMS_SENDERS=
