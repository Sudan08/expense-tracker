# Copy to .env and fill in from the Supabase project the wizard created
# (scripts/setup-wizard.sh, run from the repo root). The anon key is safe to
# ship in the app -- RLS is what actually protects the data (plan section 11.1).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Sender IDs of SMS-only banks to collect, comma-separated and matched
# case-insensitively as a substring (e.g. SMS_SENDERS=LaxmiBank,LaxmiSunrise).
# Default deny: leave this empty and the app uploads no SMS at all. Your
# inbox also holds OTPs and personal messages -- only list bank senders.
SMS_SENDERS=
