# Copy to ~/.expense-tracker/.env and fill in. Never commit the real file.
#   chmod 600 ~/.expense-tracker/.env

# Supabase Postgres, DIRECT connection (not the transaction/session pooler) --
# the worker does bulk upserts with psycopg. Project Settings -> Database ->
# Connection string -> URI -> Direct connection.
EXPENSE_TRACKER_DB_URL=postgresql://user:pass@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Gmail app password, 16 characters, spaces removed. NOT your account
# password: https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Revoke it there at any time without touching anything else.
EXPENSE_TRACKER_IMAP_PASSWORD=

# Your Supabase auth.users.id (a UUID). Every row the worker writes is keyed
# to it, and row-level security enforces that. Authentication -> Users -> UID.
EXPENSE_TRACKER_USER_ID=
